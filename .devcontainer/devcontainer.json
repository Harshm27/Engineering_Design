{
  "name": "Drawing to Solid",
  "image": "mcr.microsoft.com/devcontainers/python:3.11-bookworm",
  "features": {
    "ghcr.io/devcontainers/features/common-utils:2": { "installZsh": false }
  },
  "onCreateCommand": "sudo apt-get update && sudo apt-get install -y --no-install-recommends libgl1 libx11-6 libexpat1 libxext6 libxrender1 libsm6 libice6 && sudo rm -rf /var/lib/apt/lists/*",
  "postCreateCommand": "pip install --user -r requirements.txt",
  "forwardPorts": [8000],
  "portsAttributes": {
    "8000": { "label": "Drawing to Solid", "onAutoForward": "notify" }
  },
  "customizations": {
    "vscode": {
      "extensions": ["ms-python.python"],
      "settings": { "python.defaultInterpreterPath": "/usr/local/bin/python" }
    }
  },
  "remoteEnv": {
    "OUTDIR": "/tmp/d2s-out"
  }
}
